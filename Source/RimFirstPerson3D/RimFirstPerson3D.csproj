<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>RimFirstPerson3D</RootNamespace>
    <AssemblyName>RimFirstPerson3D</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RimWorldPath Condition="'$(RIMWORLD_PATH)' != ''">$(RIMWORLD_PATH)</RimWorldPath>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">D:\Steam\steamapps\common\RimWorld</RimWorldPath>
    <HarmonyPath>$(RimWorldPath)\Mods\Harmony\1.7\Assemblies</HarmonyPath>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(RimWorldPath)\RimWorld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldPath)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldPath)\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan">
      <HintPath>$(RimWorldPath)\Brutal.Vulkan.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Vulkan.Abstractions">
      <HintPath>$(RimWorldPath)\Brutal.Vulkan.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(RimWorldPath)\Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Common">
      <HintPath>$(RimWorldPath)\Brutal.Core.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRimWorldReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RimWorldPath)\RimWorld.dll') Or !Exists('$(RimWorldPath)\UnityStubs.dll') Or !Exists('$(RimWorldPath)\Assembly-CSharp.dll')" Text="RimWorld 1.7 references are missing under $(RimWorldPath)." />
    <Error Condition="!Exists('$(HarmonyPath)\0Harmony.dll')" Text="Harmony 1.7 reference is missing under $(HarmonyPath)." />
  </Target>

  <Target Name="DeployToRimWorldMods" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' And Exists('$(RimWorldPath)\Mods\FirstPerson3D')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\deploy.ps1&quot;" />
  </Target>

</Project>
